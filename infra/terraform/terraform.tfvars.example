# Relational State - AWS Configuration

# AWS Region
aws_region = "us-east-1"

# AWS Profile (optional - uses AWS_PROFILE env var or default if empty).
# Keep this aligned with your AWS config profiles for each account.
# aws_profile = "relational-state-dev"
aws_profile = ""

# Globally unique S3 bucket name (required).
# Example: relational-state-memory-dev-123456
memory_bucket_name = "relational-state-memory-REPLACE_ME"

# API Gateway name
api_name = "relational-state-mcp-server"

# Stage name (prod, staging, dev).
# Keep this aligned with your AWS account/environment.
stage_name = "dev"

# Lambda function name
lambda_function_name = "mcp-server"

# CloudWatch Logs retention period for API Gateway access logs (days)
# Common values: 1, 3, 5, 7, 14, 30, 60, 90, 120, 150, 180, 365, 400, 545, 731, 1827, 3653
log_retention_days = 7

# Optional ARNs to notify when alarms fire (for example, SNS topics)
alarm_actions = []

# API auth mode: JWT or NONE (NONE is for development only).
api_authorization_type = "NONE"

# Auth0 (Okta) JWT configuration.
# Set api_authorization_type = "JWT" and fill these in to enable Auth0 auth.
# jwt_issuer    = "https://YOUR_TENANT.auth0.com/"
# jwt_audiences = ["YOUR_AUTH0_API_IDENTIFIER"]

# OAuth endpoint configuration (Auth0).
# These populate the .well-known/oauth-authorization-server metadata.
# oauth_issuer                        = "https://YOUR_TENANT.auth0.com/"
# oauth_authorization_endpoint        = "https://YOUR_TENANT.auth0.com/authorize"
# oauth_token_endpoint                = "https://YOUR_TENANT.auth0.com/oauth/token"
# oauth_userinfo_endpoint             = "https://YOUR_TENANT.auth0.com/userinfo"
# oauth_jwks_uri                      = "https://YOUR_TENANT.auth0.com/.well-known/jwks.json"
# oauth_device_authorization_endpoint = "https://YOUR_TENANT.auth0.com/oauth/device/code"

# Dynamic Client Registration (DCR) shim.
# Set this to your Auth0 SPA Application client_id to enable the DCR endpoint.
# Claude.ai uses DCR to discover the client_id for OAuth flows.
# dcr_client_id = "YOUR_AUTH0_SPA_CLIENT_ID"

# Optional scopes enforced by API Gateway when using JWT auth.
jwt_authorization_scopes = []

# Optional throttling controls (null keeps AWS defaults)
throttling_burst_limit = 50
throttling_rate_limit  = 25

# Custom Domain Configuration (optional but recommended)
# Leave empty to use default API Gateway URL
custom_domain_name = ""

# ACM Certificate ARN for your custom domain
# Must be in `aws_region` (above) for API Gateway
# Create via: AWS Certificate Manager → Request certificate → FQDN
# Leave empty if not using custom domain
acm_certificate_arn = ""
